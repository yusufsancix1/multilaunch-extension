{
  "manifest_version": 3,
  "name": "MultiLaunch - Fast Tab Launcher",
  "version": "1.0.0",
  "description": "Save your favorite websites and open them instantly—individually or all at once.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
